# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Attestation signing keys (generate with: bun run generate-keys)
ATTESTATION_PRIVATE_KEY=base64-encoded-ed25519-private-key
ATTESTATION_PUBLIC_KEY=base64-encoded-ed25519-public-key

# App URL (used in attestation issuedBy field)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deploy (clawbot container)
DEPLOY_SECRET=shared-secret-for-deploy-ready-endpoint

# Railway (optional; when set, POST /api/deploy triggers a deployment)
# RAILWAY_API_TOKEN=your-railway-api-token
# RAILWAY_SERVICE_ID=service-uuid
# RAILWAY_PROJECT_ID=project-uuid
# RAILWAY_ENVIRONMENT_ID=environment-uuid
